# Writes bps/version.hpp with the app version = semver + short commit hash.
#
# Run as a script (cmake -DREPO_ROOT=... -DOUTPUT=... -P GenerateVersion.cmake)
# on every build, so the hash is never stale. The file is only rewritten when
# its content changes, so unchanged versions do not trigger recompiles.
#
# semver: the VERSION file at the repo root ("0.0.0" if missing or empty).
# commit, in order:
#   1. VERCEL_GIT_COMMIT_SHA  (set automatically during Vercel builds)
#   2. git rev-parse HEAD     (local builds)
#   3. "unknown"

cmake_policy(VERSION 3.21)

if(NOT DEFINED REPO_ROOT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "GenerateVersion.cmake needs -DREPO_ROOT=... and -DOUTPUT=...")
endif()

set(semver "")
if(EXISTS "${REPO_ROOT}/VERSION")
  file(READ "${REPO_ROOT}/VERSION" semver)
endif()
string(REGEX REPLACE "[^0-9A-Za-z.-]" "" semver "${semver}")
if(semver STREQUAL "")
  set(semver "0.0.0")
endif()

set(commit "$ENV{VERCEL_GIT_COMMIT_SHA}")
if(commit STREQUAL "")
  find_program(GIT_EXECUTABLE git)
  if(GIT_EXECUTABLE)
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
      WORKING_DIRECTORY "${REPO_ROOT}"
      OUTPUT_VARIABLE commit
      RESULT_VARIABLE git_result
      ERROR_QUIET
      OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT git_result EQUAL 0)
      set(commit "")
    endif()
  endif()
endif()
string(REGEX REPLACE "[^0-9A-Za-z]" "" commit "${commit}")
if(commit STREQUAL "")
  set(commit "unknown")
else()
  string(SUBSTRING "${commit}" 0 7 commit)
endif()

file(CONFIGURE OUTPUT "${OUTPUT}" @ONLY CONTENT
"// Generated by backend/cmake/GenerateVersion.cmake. Do not edit.
#pragma once
#define BPS_SEMVER \"@semver@\"
#define BPS_COMMIT \"@commit@\"
")
